<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | Global Destinations Travel Agency</title>
    <meta name="description" content="Discover featured travel packages to exotic and cultural locations worldwide with Global Destinations.">
    
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Linking to the dedicated final.css file -->
    <link rel="stylesheet" href="styles/final.css">
    <script src="scripts/main.js" defer></script> 
</head>
<body class="min-h-screen flex flex-col">

    <!-- Header and Navigation -->
    <header class="bg-indigo-700 text-white shadow-lg p-4 sticky top-0 z-10">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-3xl font-bold tracking-tight flex items-center">
                <i data-lucide="globe" class="w-7 h-7 inline-block mr-2 text-amber-300"></i>
                Global Destinations
            </h1>
            <nav id="nav-links" class="hidden md:flex space-x-6 text-lg font-medium">
                <a href="styles/index.html" class="text-amber-300 hover:text-amber-100 transition duration-150">Home</a>
                <a href="products.html" class="hover:text-amber-100 transition duration-150">Destinations</a>
                <a href="contact.html" class="hover:text-amber-100 transition duration-150">Contact & Reviews</a>
            </nav>
            <button id="menu-toggle" class="md:hidden p-2 rounded-lg hover:bg-indigo-600 transition duration-150" aria-label="Toggle navigation">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="container mx-auto p-4 md:p-8 flex-grow">
        
        <!-- Hero Section -->
        <section class="bg-white p-8 md:p-12 rounded-2xl shadow-xl mb-12 border-t-4 border-indigo-500">
            <h2 class="text-4xl md:text-5xl font-extrabold text-gray-800 mb-4 leading-tight text-center">
                Your Next Adventure Starts Here
            </h2>
            <p class="text-xl text-gray-600 mb-8 text-center">
                Explore our hand-picked selection of the world's most breathtaking locations.
            </p>
            <div class="text-center">
                <a href="products.html" class="inline-block bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-8 rounded-xl shadow-lg transition duration-300 transform hover:scale-[1.02]">
                    View All Destinations
                    <i data-lucide="map" class="w-5 h-5 inline-block ml-2"></i>
                </a>
            </div>
        </section>

        <!-- Featured Destinations Section (Uses JS displayDestinations) -->
        <section class="mb-12">
            <h3 class="text-3xl font-bold text-gray-800 mb-6 border-b-2 pb-2">Featured Destinations</h3>
            
            <!-- Dynamic Content Container -->
            <div id="featured-destinations-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Destinations loaded by main.js (limit = 3) -->
            </div>
        </section>

    </main>

    <!-- Footer Section (Common to all pages) -->
    <footer class="bg-gray-800 text-white p-4 mt-8">
        <div class="container mx-auto text-center text-sm">
            <p>
                &copy;<span id="copyright-year"></span> Global Destinations. All Rights Reserved. 
            </p>
        </div>
    </footer>
    
    <!-- Initialize Lucide Icons -->
    <script>
        lucide.createIcons();
    </script>
</body>
</html>